# Copy to .env.local and fill in. Committed as documentation; holds no real values.

# Encrypts the session cookie (A256GCM needs exactly 32 bytes, base64-encoded).
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Base URL of auth-service. Defaults to http://localhost:8081 when unset.
# Server-side only — deliberately not NEXT_PUBLIC_, because the browser never calls auth-service directly.
AUTH_SERVICE_URL=http://localhost:8081
