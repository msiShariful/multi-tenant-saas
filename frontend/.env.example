# Copy to .env.local and fill in. Committed as documentation; holds no real values.

# Encrypts the session cookie (A256GCM needs exactly 32 bytes, base64-encoded).
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# The platform's single entry point. The BFF calls the gateway, not the services behind it, so
# service ports and the auth/user split stay private to the backend. Defaults to :8080 when unset.
# Server-side only — deliberately not NEXT_PUBLIC_, because the browser never calls it directly.
GATEWAY_URL=http://localhost:8080
