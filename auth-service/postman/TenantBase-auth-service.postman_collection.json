                "tenants"
              ]
            },
            "description": "The only unauthenticated write. Creates the tenant and its first administrator in one transaction.\n\nRe-running returns 409 \u2014 change `tenantSlug` to create another one.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantName\": \"{{tenantName}}\",\n  \"tenantSlug\": \"{{tenantSlug}}\",\n  \"adminEmail\": \"{{email}}\",\n  \"adminPassword\": \"{{password}}\",\n  \"firstName\": \"Ada\",\n  \"lastName\": \"Lovelace\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created (409 if the slug is taken)', () =>",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 409]));",
                  "if (pm.response.code === 201) {",
                  "    const b = pm.response.json();",
                  "    pm.collectionVariables.set('tenantId', b.tenant.id);",
                  "    pm.collectionVariables.set('userId', b.administrator.id);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
