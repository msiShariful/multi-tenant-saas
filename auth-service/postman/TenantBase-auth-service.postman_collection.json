{
  "info": {
    "name": "TenantBase Auth Service",
    "description": "Multi-tenant authentication, tenant provisioning and RBAC.\n\n**Just press Send.** Collection-level bearer auth reads `{{accessToken}}`, and a pre-request script keeps it valid: it refreshes an expiring token, signs in again if that fails, and registers the tenant first if it does not exist yet. You never copy a token anywhere, and any request works even on an empty database. Open the Postman console to see what it did.\n\nChange `baseUrl` (default `http://localhost:8081`) and the credential variables under the collection's **Variables** tab.\n\nStart the API with `docker compose up --build`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "/*",
          " * Keeps a valid access token on the collection so nothing is ever pasted by hand.",
          " *",
          " *   token still valid          -> nothing",
          " *   token expiring or missing  -> rotate the refresh token",
          " *   refresh rejected           -> log in again",
          " *   tenant not registered yet  -> register it, then log in",
          " *",
          " * Public endpoints are skipped so this cannot recurse. Steps are logged to the console.",
          " */",
          "const SKIP = ['/actuator', '/.well-known', '/api/v1/tenants',",
          "              '/api/v1/auth/login', '/api/v1/auth/token/refresh'];",
          "const path = pm.request.url.getPath();",
          "const base = pm.collectionVariables.get('baseUrl');",
          "",
          "if (SKIP.some((p) => path.startsWith(p))) {",
          "    // public - nothing to do",
          "} else if (pm.collectionVariables.get('accessToken') &&",
          "           Date.now() + 30000 < Number(pm.collectionVariables.get('accessTokenExpiresAt') || 0)) {",
          "    // still valid - nothing to do",
          "} else {",
          "    const store = (b) => {",
          "        pm.collectionVariables.set('accessToken', b.accessToken);",
          "        pm.collectionVariables.set('refreshToken', b.refreshToken);",
          "        pm.collectionVariables.set('accessTokenExpiresAt', Date.now() + b.expiresIn * 1000);",
          "        const d = (() => { try { return require('atob'); } catch (e) { return atob; } })();",
          "        const c = JSON.parse(d(b.accessToken.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));",
          "        pm.collectionVariables.set('tenantId', c.tenant_id);",
          "        pm.collectionVariables.set('userId', c.sub);",
          "    };",
          "    const post = (url, payload) => ({",
          "        url: base + url, method: 'POST',",
          "        header: { 'Content-Type': 'application/json' },",
          "        body: { mode: 'raw', raw: JSON.stringify(payload) }",
          "    });",
          "    const login = (done) => pm.sendRequest(post('/api/v1/auth/login', {",
          "        tenantSlug: pm.collectionVariables.get('tenantSlug'),",
          "        email: pm.collectionVariables.get('email'),",
          "        password: pm.collectionVariables.get('password')",
          "    }), (e, r) => {",
          "        if (!e && r.code === 200) { store(r.json()); console.log('[auto] signed in'); return done(true); }",
          "        done(false);",
          "    });",
          "    const register = (done) => pm.sendRequest(post('/api/v1/tenants', {",
          "        tenantName: pm.collectionVariables.get('tenantName'),",
          "        tenantSlug: pm.collectionVariables.get('tenantSlug'),",
          "        adminEmail: pm.collectionVariables.get('email'),",
          "        adminPassword: pm.collectionVariables.get('password'),",
          "        firstName: 'Ada', lastName: 'Lovelace'",
          "    }), () => { console.log('[auto] tenant ready'); done(); });",
          "",
          "    const refresh = pm.collectionVariables.get('refreshToken');",
          "    if (refresh) {",
          "        pm.sendRequest(post('/api/v1/auth/token/refresh', { refreshToken: refresh }), (e, r) => {",
          "            if (!e && r.code === 200) { store(r.json()); console.log('[auto] token refreshed'); return; }",
          "            login((ok) => { if (!ok) register(() => login(() => {})); });",
          "        });",
          "    } else {",
          "        login((ok) => { if (!ok) register(() => login(() => {})); });",
          "    }",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "tenantName",
