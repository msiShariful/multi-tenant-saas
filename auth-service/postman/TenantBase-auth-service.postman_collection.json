                "{{baseUrl}}"
              ],
              "path": [
                ".well-known",
                "jwks.json"
              ]
            },
            "description": "Public signing key. Other services point `jwk-set-uri` here and verify tokens locally.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('no private key material', () =>",
                  "    pm.expect(pm.response.json().keys[0]).to.not.have.property('d'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
