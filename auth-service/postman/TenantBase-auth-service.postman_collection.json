      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Credentials are (tenant slug, email, password) \u2014 email is unique per tenant, not globally.\n\nStores the token pair on the collection, so no other request needs a token pasted into it.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantSlug\": \"{{tenantSlug}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', b.accessToken);",
                  "pm.collectionVariables.set('refreshToken', b.refreshToken);",
                  "pm.collectionVariables.set('accessTokenExpiresAt', Date.now() + b.expiresIn * 1000);",
                  "const b64 = (() => { try { return require('atob'); } catch (e) { return atob; } })();",
                  "const c = JSON.parse(b64(b.accessToken.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));",
                  "pm.collectionVariables.set('tenantId', c.tenant_id);",
                  "pm.collectionVariables.set('userId', c.sub);",
                  "",
                  "} else {",
                  "    // First run against an empty database: the tenant does not exist yet. Register it and retry,",
                  "    // so Login works on its own instead of having to run Tenant > Register tenant first.",
                  "    console.log('Login returned ' + pm.response.code + ' - registering the tenant, then retrying.');",
                  "    const base = pm.collectionVariables.get('baseUrl');",
                  "    const post = (u, payload) => ({ url: base + u, method: 'POST',",
                  "        header: { 'Content-Type': 'application/json' },",
                  "        body: { mode: 'raw', raw: JSON.stringify(payload) } });",
                  "    pm.sendRequest(post('/api/v1/tenants', {",
                  "        tenantName: pm.collectionVariables.get('tenantName'),",
                  "        tenantSlug: pm.collectionVariables.get('tenantSlug'),",
                  "        adminEmail: pm.collectionVariables.get('email'),",
                  "        adminPassword: pm.collectionVariables.get('password'),",
                  "        firstName: 'Ada', lastName: 'Lovelace'",
                  "    }), () => {",
                  "        pm.sendRequest(post('/api/v1/auth/login', {",
                  "            tenantSlug: pm.collectionVariables.get('tenantSlug'),",
                  "            email: pm.collectionVariables.get('email'),",
                  "            password: pm.collectionVariables.get('password')",
                  "        }), (e, r) => {",
                  "            pm.test('signed in after registering the tenant', () => pm.expect(r.code).to.eql(200));",
                  "            if (e || r.code !== 200) return;",
                  "            const b = r.json();",
                  "            pm.collectionVariables.set('accessToken', b.accessToken);",
                  "            pm.collectionVariables.set('refreshToken', b.refreshToken);",
                  "            pm.collectionVariables.set('accessTokenExpiresAt', Date.now() + b.expiresIn * 1000);",
                  "            const d = (() => { try { return require('atob'); } catch (x) { return atob; } })();",
                  "            const c = JSON.parse(d(b.accessToken.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));",
                  "            pm.collectionVariables.set('tenantId', c.tenant_id);",
                  "            pm.collectionVariables.set('userId', c.sub);",
                  "        });",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('roles are present', () => pm.expect(pm.response.json().roles).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/token/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "token",
                "refresh"
              ]
            },
            "description": "Refresh tokens are single use \u2014 the response carries a new one, stored automatically. Replaying a spent token revokes the whole session family.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const previous = pm.collectionVariables.get('refreshToken');",
                  "pm.test('token was rotated', () =>",
                  "    pm.expect(pm.response.json().refreshToken).to.not.eql(previous));",
                  "",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', b.accessToken);",
                  "pm.collectionVariables.set('refreshToken', b.refreshToken);",
                  "pm.collectionVariables.set('accessTokenExpiresAt', Date.now() + b.expiresIn * 1000);",
                  "const b64 = (() => { try { return require('atob'); } catch (e) { return atob; } })();",
                  "const c = JSON.parse(b64(b.accessToken.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));",
                  "pm.collectionVariables.set('tenantId', c.tenant_id);",
                  "pm.collectionVariables.set('userId', c.sub);"
                ]
              }
            }
          ]
        },
        {
          "name": "Change password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "password"
              ]
            },
            "description": "Revokes every refresh token the user holds, so all their devices must sign in again.\n\nThe test script changes it straight back to `{{password}}` afterwards, so the collection is left exactly as it was and this can be re-run any number of times.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{password}}\",\n  \"newPassword\": \"{{altPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));",
                  "",
                  "// Put it back so the stored credentials stay correct.",
                  "const base = pm.collectionVariables.get('baseUrl');",
                  "const slug = pm.collectionVariables.get('tenantSlug');",
                  "const email = pm.collectionVariables.get('email');",
                  "const original = pm.collectionVariables.get('password');",
                  "const temp = pm.collectionVariables.get('altPassword');",
                  "const json = (u, p, t) => ({ url: base + u, method: 'POST',",
                  "    header: Object.assign({ 'Content-Type': 'application/json' }, t ? { Authorization: 'Bearer ' + t } : {}),",
                  "    body: { mode: 'raw', raw: JSON.stringify(p) } });",
                  "",
                  "pm.sendRequest(json('/api/v1/auth/login', { tenantSlug: slug, email: email, password: temp }), (e1, r1) => {",
                  "    if (e1 || r1.code !== 200) return;",
                  "    const token = r1.json().accessToken;",
                  "    pm.sendRequest(json('/api/v1/auth/password',",
                  "        { currentPassword: temp, newPassword: original }, token), (e2, r2) => {",
                  "        pm.test('password restored', () => pm.expect(r2.code).to.eql(204));",
                  "        pm.sendRequest(json('/api/v1/auth/login',",
                  "            { tenantSlug: slug, email: email, password: original }), (e3, r3) => {",
                  "            if (e3 || r3.code !== 200) return;",
                  "            const b = r3.json();",
                  "            pm.collectionVariables.set('accessToken', b.accessToken);",
                  "            pm.collectionVariables.set('refreshToken', b.refreshToken);",
                  "            pm.collectionVariables.set('accessTokenExpiresAt', Date.now() + b.expiresIn * 1000);",
                  "        });",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "logout"
              ]
            },
            "description": "Revokes the presented session. Returns 204 whether or not the token existed, so it cannot be used to probe token validity.\n\nThe collection signs back in on the next request automatically.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));",
                  "pm.collectionVariables.set('accessToken', '');",
                  "pm.collectionVariables.set('refreshToken', '');",
                  "pm.collectionVariables.set('accessTokenExpiresAt', '0');"
                ]
              }
            }
          ]
        }
      ]
    },
    {
