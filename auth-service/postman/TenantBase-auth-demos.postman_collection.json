              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('is the member', () =>",
                  "    pm.expect(pm.response.json().roles).to.eql(['TENANT_USER']));"
                ]
              }
            }
          ]
        },
        {
          "name": "The last administrator cannot be demoted",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}/roles",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "{{userId}}",
                "roles"
              ]
            },
            "description": "Demoting the tenant's only administrator would lock it out permanently, and recovery would need a database edit \u2014 a support ticket that should not be possible to create through the API.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roles\": [\n    \"TENANT_USER\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('code is LAST_ADMINISTRATOR', () =>",
                  "    pm.expect(pm.response.json().code).to.eql('LAST_ADMINISTRATOR'));"
                ]
              }
            }
          ]
        },
        {
          "name": "A role change applies to the next token, not the current one",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{memberUserId}}/roles",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "{{memberUserId}}",
                "roles"
              ]
            },
            "description": "Promotes the member, then shows their **existing** token still being refused, and a freshly issued one working.\n\nRoles are claims inside a signed document; nothing can edit one after the fact. That staleness is bounded by `access-token-ttl` (15 minutes), which is why it is measured in minutes. Demoted back at the end.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roles\": [\n    \"TENANT_ADMIN\",\n    \"TENANT_USER\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Resolve the member's id so this request stands alone.",
                  "pm.sendRequest({",
                  "    url: pm.collectionVariables.get('baseUrl') + '/api/v1/users?size=200', method: 'GET',",
                  "    header: { Authorization: 'Bearer ' + pm.collectionVariables.get('accessToken') }",
                  "}, (e, r) => {",
                  "    if (e || r.code !== 200) return;",
                  "    const wanted = pm.collectionVariables.get('memberEmail').toLowerCase();",
                  "    const found = r.json().content.find((u) => u.email === wanted);",
                  "    if (found) pm.collectionVariables.set('memberUserId', found.id);",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('promoted to TENANT_ADMIN', () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().roles).to.include('TENANT_ADMIN');",
                  "});",
                  "",
                  "const base = pm.collectionVariables.get('baseUrl');",
                  "const stale = pm.collectionVariables.get('memberAccessToken');",
                  "const admin = pm.collectionVariables.get('accessToken');",
                  "",
                  "pm.sendRequest({ url: base + '/api/v1/users', method: 'GET',",
                  "    header: { Authorization: 'Bearer ' + stale } }, (e1, r1) => {",
                  "    pm.test('the token issued BEFORE the promotion is still refused', () =>",
                  "        pm.expect(r1.code).to.eql(403));",
                  "",
                  "    pm.sendRequest({ url: base + '/api/v1/auth/login', method: 'POST',",
                  "        header: { 'Content-Type': 'application/json' },",
                  "        body: { mode: 'raw', raw: JSON.stringify({",
                  "            tenantSlug: pm.collectionVariables.get('tenantSlug'),",
                  "            email: pm.collectionVariables.get('memberEmail'),",
                  "            password: pm.collectionVariables.get('memberPassword')",
                  "        }) } }, (e2, r2) => {",
                  "        const fresh = r2.json().accessToken;",
                  "        pm.sendRequest({ url: base + '/api/v1/users', method: 'GET',",
                  "            header: { Authorization: 'Bearer ' + fresh } }, (e3, r3) => {",
                  "            pm.test('a token issued AFTER it is accepted', () => pm.expect(r3.code).to.eql(200));",
                  "",
                  "            // Put the member back so this can be run again.",
                  "            pm.sendRequest({ url: base + '/api/v1/users/' +",
                  "                pm.collectionVariables.get('memberUserId') + '/roles', method: 'PUT',",
                  "                header: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + admin },",
                  "                body: { mode: 'raw', raw: JSON.stringify({ roles: ['TENANT_USER'] }) } }, () => {});",
                  "        });",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        }
      ],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const base = pm.collectionVariables.get('baseUrl');",
              "const admin = pm.collectionVariables.get('accessToken');",
              "",
              "pm.sendRequest({",
              "    url: base + '/api/v1/users', method: 'POST',",
              "    header: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + admin },",
              "    body: { mode: 'raw', raw: JSON.stringify({",
              "        email: pm.collectionVariables.get('memberEmail'),",
              "        password: pm.collectionVariables.get('memberPassword'),",
              "        firstName: 'Grace', lastName: 'Hopper', roles: ['TENANT_USER']",
              "    }) }",
              "}, () => {",
              "    pm.sendRequest({",
              "        url: base + '/api/v1/auth/login', method: 'POST',",
              "        header: { 'Content-Type': 'application/json' },",
              "        body: { mode: 'raw', raw: JSON.stringify({",
              "            tenantSlug: pm.collectionVariables.get('tenantSlug'),",
              "            email: pm.collectionVariables.get('memberEmail'),",
              "            password: pm.collectionVariables.get('memberPassword')",
              "        }) }",
              "    }, (e, r) => {",
              "        if (!e && r.code === 200) pm.collectionVariables.set('memberAccessToken', r.json().accessToken);",
              "    });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Login protection",
      "description": "What a failed login does and does not reveal.",
      "item": [
        {
          "name": "Every failure looks identical",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Fires three different failures \u2014 wrong password, unknown email, unknown tenant \u2014 and asserts the three response bodies are **byte-identical** apart from the timestamp.\n\nIf they differed, login would be an oracle for discovering which tenants and accounts exist. The service also verifies a dummy hash on the miss path, so the timing matches too.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantSlug\": \"{{tenantSlug}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"not the password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "const base = pm.collectionVariables.get('baseUrl');",
                  "const attempt = (payload, cb) => pm.sendRequest({",
                  "    url: base + '/api/v1/auth/login', method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: { mode: 'raw', raw: JSON.stringify(payload) } }, cb);",
                  "const shape = (res) => { const b = res.json(); delete b.timestamp; return JSON.stringify(b); };",
                  "",
                  "const wrongPassword = shape(pm.response);",
                  "attempt({ tenantSlug: pm.collectionVariables.get('tenantSlug'),",
                  "          email: 'nobody-' + Date.now() + '@acme.example', password: 'whatever' }, (e1, unknownUser) => {",
                  "    attempt({ tenantSlug: 'no-such-tenant-' + Date.now(),",
                  "              email: pm.collectionVariables.get('email'), password: 'whatever' }, (e2, unknownTenant) => {",
                  "        pm.test('unknown email is indistinguishable from a wrong password', () =>",
                  "            pm.expect(shape(unknownUser)).to.eql(wrongPassword));",
                  "        pm.test('unknown tenant is indistinguishable too', () =>",
                  "            pm.expect(shape(unknownTenant)).to.eql(wrongPassword));",
                  "        console.log('all three:', wrongPassword);",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Repeated failures lock the account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users"
              ]
            },
            "description": "Creates a **throwaway** user and hammers its login until the lockout trips, so no account you care about is locked for 15 minutes.\n\n423 Locked rather than 401: the credentials stopped being the point. The threshold is `tenantbase.security.login.max-failed-attempts` (5 by default).\n\nWorth noting what this proves internally: the failed-attempt counter survives requests that were themselves rejected, which only works because the login transaction commits the counter before the failure is thrown.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"lockout-{{$timestamp}}@acme.example\",\n  \"password\": \"a throwaway passphrase\",\n  \"firstName\": \"Lock\",\n  \"lastName\": \"Target\",\n  \"roles\": [\n    \"TENANT_USER\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('throwaway user created', () => pm.response.to.have.status(201));",
                  "const email = pm.response.json().email;",
                  "const base = pm.collectionVariables.get('baseUrl');",
                  "",
                  "const attempt = (n, done) => {",
                  "    if (n === 0) return done(null);",
                  "    pm.sendRequest({ url: base + '/api/v1/auth/login', method: 'POST',",
                  "        header: { 'Content-Type': 'application/json' },",
                  "        body: { mode: 'raw', raw: JSON.stringify({",
                  "            tenantSlug: pm.collectionVariables.get('tenantSlug'),",
                  "            email: email, password: 'wrong-' + n }) }",
                  "    }, (e, r) => (r && r.code === 423) ? done(r) : attempt(n - 1, done));",
                  "};",
                  "",
                  "attempt(8, (locked) => {",
                  "    pm.test('the account locks', () => pm.expect(locked, 'no 423 within 8 attempts').to.not.be.null);",
                  "    if (locked) {",
                  "        pm.test('423 with a code and an unlock time', () => {",
                  "            const b = locked.json();",
                  "            pm.expect(b.code).to.eql('ACCOUNT_LOCKED');",
                  "            pm.expect(b).to.have.property('lockedUntil');",
                  "        });",
                  "        console.log('locked until', locked.json().lockedUntil);",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Error format",
      "description": "Every failure in the service is an RFC 9457 `application/problem+json` document with a stable `code` member. Branch on `code`, never on `detail`.",
      "item": [
        {
          "name": "No credentials",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            },
            "description": "Raised inside the security filter chain, upstream of the controllers \u2014 where most APIs end up emitting an empty 401 in a different shape from their business errors.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('is problem+json, not an empty body', () =>",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('problem+json'));",
                  "pm.test('code is UNAUTHENTICATED', () =>",
                  "    pm.expect(pm.response.json().code).to.eql('UNAUTHENTICATED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Malformed bearer token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            },
            "description": "A token that is not a JWT at all. 401, never a 500 with a stack trace.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "not-a-real-jwt",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('no stack trace leaks', () =>",
                  "    pm.expect(pm.response.text()).to.not.include('org.springframework'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid request body",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tenants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tenants"
              ]
            },
            "description": "Three fields fail validation at once. The response names each of them, rather than failing on the first and making the client guess the rest.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenantName\": \"Acme\",\n  \"tenantSlug\": \"Not A Slug\",\n  \"adminEmail\": \"not-an-email\",\n  \"adminPassword\": \"short\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "const b = pm.response.json();",
                  "pm.test('code is VALIDATION_FAILED', () => pm.expect(b.code).to.eql('VALIDATION_FAILED'));",
                  "pm.test('reports all three fields', () => pm.expect(b.errors).to.have.lengthOf(3));",
                  "console.log(b.errors.map((e) => e.field + ': ' + e.message).join('\\n'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
