{
  "info": {
    "name": "TenantBase Auth Demos",
    "description": "Companion to **TenantBase Auth Service**. Every request here demonstrates a design decision, and asserts it.\n\nNothing to set up: the collection signs itself in and provisions whatever a folder needs (a second tenant, an ordinary member, a throwaway account), so any request can be sent on its own against an empty database.\n\nEverything is non-destructive. Demos that revoke a session sign back in, the promotion demo demotes again, and the lockout demo locks a throwaway user rather than yours.\n\nStart with **Tenant isolation \u2192 Cross-tenant read returns 404, not 403**.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "/*",
          " * Keeps a valid administrator token on the collection, registering the tenant first if the",
          " * database is empty. Identical to the main TenantBase collection, so this one works on its own.",
          " */",
          "const SKIP = ['/actuator', '/.well-known', '/api/v1/tenants',",
          "              '/api/v1/auth/login', '/api/v1/auth/token/refresh'];",
          "const path = pm.request.url.getPath();",
          "const base = pm.collectionVariables.get('baseUrl');",
          "",
          "if (SKIP.some((p) => path.startsWith(p))) {",
          "    // public - nothing to do",
          "} else if (pm.collectionVariables.get('accessToken') &&",
          "           Date.now() + 30000 < Number(pm.collectionVariables.get('accessTokenExpiresAt') || 0)) {",
          "    // still valid - nothing to do",
          "} else {",
          "    const store = (b) => {",
          "        pm.collectionVariables.set('accessToken', b.accessToken);",
          "        pm.collectionVariables.set('refreshToken', b.refreshToken);",
          "        pm.collectionVariables.set('accessTokenExpiresAt', Date.now() + b.expiresIn * 1000);",
          "        const d = (() => { try { return require('atob'); } catch (e) { return atob; } })();",
          "        const c = JSON.parse(d(b.accessToken.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));",
          "        pm.collectionVariables.set('tenantId', c.tenant_id);",
          "        pm.collectionVariables.set('userId', c.sub);",
          "    };",
          "    const post = (u, payload) => ({ url: base + u, method: 'POST',",
          "        header: { 'Content-Type': 'application/json' },",
          "        body: { mode: 'raw', raw: JSON.stringify(payload) } });",
          "    const login = (done) => pm.sendRequest(post('/api/v1/auth/login', {",
          "        tenantSlug: pm.collectionVariables.get('tenantSlug'),",
          "        email: pm.collectionVariables.get('email'),",
          "        password: pm.collectionVariables.get('password')",
          "    }), (e, r) => {",
          "        if (!e && r.code === 200) { store(r.json()); return done(true); }",
          "        done(false);",
          "    });",
          "    const register = (done) => pm.sendRequest(post('/api/v1/tenants', {",
          "        tenantName: pm.collectionVariables.get('tenantName'),",
          "        tenantSlug: pm.collectionVariables.get('tenantSlug'),",
          "        adminEmail: pm.collectionVariables.get('email'),",
          "        adminPassword: pm.collectionVariables.get('password'),",
          "        firstName: 'Ada', lastName: 'Lovelace'",
          "    }), () => done());",
          "",
          "    const refresh = pm.collectionVariables.get('refreshToken');",
          "    if (refresh) {",
          "        pm.sendRequest(post('/api/v1/auth/token/refresh', { refreshToken: refresh }), (e, r) => {",
          "            if (!e && r.code === 200) { store(r.json()); return; }",
          "            login((ok) => { if (!ok) register(() => login(() => {})); });",
          "        });",
          "    } else {",
          "        login((ok) => { if (!ok) register(() => login(() => {})); });",
          "    }",
          "}"
        ]
      }
    }
  ],
